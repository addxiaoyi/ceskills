{
  "name": "ceskills",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "dev:server": "pnpm --filter @ceskills/server dev",
    "dev:web": "pnpm --filter @ceskills/web dev",
    "crawl": "pnpm --filter @ceskills/server exec tsx ../../.opencode/skills/craftengine-wiki/scripts/crawl.ts",
    "extract": "pnpm --filter @ceskills/server exec tsx ../../.opencode/skills/craftengine-wiki/scripts/extract.ts",
    "graph:build": "pnpm --filter @ceskills/server exec tsx ../../.opencode/skills/craftengine-wiki/scripts/build.ts",
    "export-skill": "pnpm --filter @ceskills/server exec tsx ../../.opencode/skills/craftengine-wiki/scripts/export-skill.ts",
    "skill:check": "node .opencode/skills/craftengine-wiki/pack/scripts/selfcheck.mjs",
    "skill:query": "node .opencode/skills/craftengine-wiki/pack/scripts/query.mjs",
    "skill:route": "node .opencode/skills/craftengine-wiki/pack/scripts/route.mjs",
    "skill:answer": "node .opencode/skills/craftengine-wiki/pack/scripts/answer.mjs",
    "skill:list": "node .opencode/skills/craftengine-wiki/pack/scripts/list.mjs",
    "skill:lint": "node .opencode/skills/craftengine-wiki/pack/scripts/lint.mjs",
    "skill:gen": "node .opencode/skills/craftengine-wiki/pack/scripts/generate.mjs",
    "skill:opt": "node .opencode/skills/craftengine-wiki/pack/scripts/optimize.mjs",
    "skill:liubu": "node .opencode/skills/craftengine-wiki/pack/scripts/liubu.mjs",
    "skill:apply": "node .opencode/skills/craftengine-wiki/pack/scripts/apply.mjs",
    "skill:status": "node .opencode/skills/craftengine-wiki/pack/scripts/liubu.mjs status",
    "skill:pack": "node .opencode/skills/craftengine-wiki/scripts/pack-install.mjs"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}