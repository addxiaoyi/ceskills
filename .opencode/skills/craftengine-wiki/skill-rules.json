{
  "craftengine-wiki": {
    "type": "domain",
    "enforcement": "suggest",
    "priority": "high",
    "promptTriggers": {
      "keywords": [
        "craftengine",
        "ce-pre.gtemc.cn",
        "craftengine wiki",
        "craftengine 配置",
        "craftengine yaml",
        "三省六部",
        "拟旨",
        "封驳",
        "准奏",
        "座椅方块",
        "自定义方块",
        "自定义物品",
        "家具配置",
        "审核配置",
        "生成配置"
      ],
      "intentPatterns": [
        "(爬取|抓取|同步).*(craftengine|wiki)",
        "(生成|审核|优化|落档|回写).*(配置|yaml|yml)",
        "(如何|怎么).*(配置|注册|创建|添加).*(方块|物品|配方|家具|座椅)",
        "(三省六部|中书|门下|六部|准奏|封驳)"
      ]
    },
    "fileTriggers": {
      "patterns": [
        "**/*craftengine*",
        "**/pack/edicts/**",
        "data/projects/craftengine-wiki/**"
      ]
    }
  }
}
